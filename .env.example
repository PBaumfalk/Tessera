# Kopieren nach .env und anpassen. Alle Variablen sind optional.
# Ausführliche Beschreibung: docs/konfiguration.md

# Port auf dem Docker-Host
TESSERA_PORT=8080

# Adresse, unter der die Oberfläche im Intranet erreichbar ist (für OIDC und Links)
# APP_URL=https://qr.intranet.firma.de

# Basisadresse für dynamische Kurzlinks (muss für scannende Smartphones erreichbar sein)
# Leer = in den Einstellungen festlegen bzw. APP_URL verwenden
# PUBLIC_BASE_URL=https://go.firma.de

# Hinter einem Reverse Proxy (Traefik, nginx, Caddy): IP/CIDR des Proxys (empfohlen)
# "true" vertraut jedem X-Forwarded-For – nur, wenn Tessera ausschließlich über den Proxy erreichbar ist
# TRUST_PROXY=172.18.0.0/16

# Weitere Hostnamen der Oberfläche (neben APP_URL), z. B. Kurzname oder IP
# ALLOWED_HOSTS=qr,10.0.0.12

# Schlüssel für verschlüsselte Felder (WLAN-Passwörter, IBAN). Ohne Angabe wird
# /data/secret.key erzeugt. Mindestens 32 Zeichen. NICHT nachträglich ändern.
# SECRET_KEY=

# Erstes Administratorkonto automatisch anlegen (sonst Einrichtungscode im Protokoll)
# ADMIN_EMAIL=admin@firma.de
# ADMIN_PASSWORD=

# OIDC / authentik
# OIDC_ISSUER=https://auth.firma.de/application/o/tessera/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Mit authentik anmelden
# OIDC_ADMIN_GROUPS=tessera-admins
# OIDC_ALLOWED_GROUPS=
# OIDC_DEFAULT_ROLE=editor
# Bestehende lokale Konten per verifizierter E-Mail verknüpfen (Standard: aus)
# OIDC_LINK_BY_EMAIL=false
# AUTH_LOCAL=true

# Nur in vertrauenswürdigen Netzen: ganz ohne Anmeldung
# AUTH_DISABLED=false

# LOG_LEVEL=info
# MAX_UPLOAD_MB=25
